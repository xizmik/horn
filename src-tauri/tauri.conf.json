{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HORN",
  "version": "0.2.0",
  "identifier": "com.horn.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HГRN",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 650,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": true
      },
      {
        "label": "island",
        "title": "HГRN Dynamic Island",
        "url": "island.html",
        "width": 580,
        "height": 340,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"]
  }
}