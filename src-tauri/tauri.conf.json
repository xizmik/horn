{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HORN",
  "version": "0.1.0",
  "identifier": "com.horn.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HØRN",
        "url": "index.html",
        "width": 1140,
        "height": 740,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": true
      },
      {
        "label": "island",
        "title": "HØRN Dynamic Island",
        "url": "island.html",
        "width": 480,
        "height": 230,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"]
  }
}