{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HORN",
  "version": "0.2.5",
  "identifier": "com.horn.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HØRN",
        "url": "index.html",
        "width": 1200,
        "height": 780,
        "minWidth": 980,
        "minHeight": 650,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": true
      },
      {
        "label": "island",
        "title": "HØRN Dynamic Island",
        "url": "island.html",
        "width": 620,
        "height": 380,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "resources": ["icons/app-icon.png"]
  }
}